{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tools/meta-tag-optimizer/",
      "destination": "/tools/meta-tags/",
      "permanent": true
    },
    {
      "source": "/tools/base64-encode-decode/",
      "destination": "/tools/base64/",
      "permanent": true
    },
    {
      "source": "/tools/url-encoder-decoder/",
      "destination": "/tools/url-encoder/",
      "permanent": true
    },
    {
      "source": "/tools/html-entity-encoder/",
      "destination": "/tools/entity-encoder/",
      "permanent": true
    },
    {
      "source": "/tools/html-entity-encoder-decoder/",
      "destination": "/tools/entity-encoder/",
      "permanent": true
    },
    {
      "source": "/tools/dev-tools/",
      "destination": "/tools/developer-tools/",
      "permanent": true
    },
    {
      "source": "/tools/web-tools/",
      "destination": "/tools/web-security-tools/",
      "permanent": true
    },
    {
      "source": "/tools/security-tools/",
      "destination": "/tools/web-security-tools/",
      "permanent": true
    }
  ]
}
