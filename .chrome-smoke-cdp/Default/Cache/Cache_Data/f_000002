/* ---------- PARTICLES: più luminose e presenti ---------- */
/* Alza la visibilità del layer */
#clickozParticles{
  opacity: 1 !important;
  filter: saturate(1.18) brightness(1.12) !important;
}

/* Dots idle: più grandi e molto più visibili */
.pidle{
  width: 3px !important;
  height: 3px !important;
  opacity: .72 !important;
  filter: saturate(1.15) brightness(1.20) !important;
  box-shadow:
    0 0 18px rgba(var(--accent-rgb), .72),
    0 0 56px rgba(var(--accent-rgb), .26) !important;
}

/* twinkle un filo più evidente */
@keyframes idleTwinkle{
  0%,100% { filter: brightness(1.05); }
  50%     { filter: brightness(1.45); }
}

/* ---------- KILL CANVAS: sparisce proprio ---------- */
#spaceParticles{
  display: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
}

