/* =========================================================
   CLICKoz — site.css (CLEAN / ONE FILE) — MOBILE FIRST
   - Base UI + Layout
   - Accent glow background (ONE version)
   - Nav + Accent dropdown + Mobile drawer styles
   - Hero / Sections
   - Cards (perfect alignment) + CTA pinned bottom
   - Recommended cards
   - Search + Chips
   - Guides small cards
   - Footer
   - Cookie banner
   - Google Translate dark (best-effort)
   - Grain + Particles layers (CSS + canvas ready)
========================================================= */

/* ---------------- Root + Reset ---------------- */
:root{
  color-scheme: dark;

  --bg:#0b0f19;
  --panel: rgba(15,21,38,.78);
  --panel2: rgba(17,26,48,.86);

  --text: rgba(255,255,255,.92);
  --muted: rgba(255,255,255,.72);

  --border: rgba(255,255,255,.10);
  --border2: rgba(255,255,255,.16);

  --radius: 14px;

  /* accent overridden by JS/color picker */
 --accent: #22d3ee;        /* cyan */
 --accent2:#06b6d4;        /* cyan 2 (opzionale) */
  --accent-rgb: 34,211,238; /* rgb del cyan */


  --shadow: 0 18px 60px rgba(0,0,0,.40);
  --shadow2: 0 10px 26px rgba(0,0,0,.35);
  --focus: 0 0 0 4px rgba(var(--accent-rgb), .16);

  --navH: 72px;
}

*{ box-sizing:border-box; }
a{ color: inherit; }
img{ max-width:100%; display:block; }

html, body{ overflow-x:hidden; }
body{
  margin: 0;
  font-family: "Plus Jakarta Sans", Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  position: relative;
}

/* Optional: slightly bigger base text (your existing use) */
body.bigtext{ font-size: 17px; }

/* ---------------- Background (ONE only) ---------------- */
body::before{
  content:"";
  position: fixed;
  inset: -60%;
  pointer-events:none;
  z-index: -4;
  background:
    radial-gradient(1500px 900px at 50% -12%, rgba(var(--accent-rgb), .38), transparent 66%),
    radial-gradient(1100px 900px at -10% 44%, rgba(var(--accent-rgb), .16), transparent 78%),
    radial-gradient(1100px 900px at 110% 44%, rgba(var(--accent-rgb), .16), transparent 78%),
    radial-gradient(1700px 1200px at 50% 62%, rgba(var(--accent-rgb), .10), transparent 84%),
    radial-gradient(1700px 900px at 50% 118%, rgba(var(--accent-rgb), .08), transparent 90%);
  filter: blur(62px);
  opacity: .95;
}
body::after{
  content:"";
  position: fixed;
  inset: -35%;
  pointer-events:none;
  z-index: -3;
  background:
    radial-gradient(1200px 900px at 18% 26%, rgba(var(--accent-rgb), .08), transparent 82%),
    radial-gradient(1200px 900px at 82% 26%, rgba(var(--accent-rgb), .08), transparent 82%),
    radial-gradient(1700px 1200px at 50% 72%, rgba(var(--accent-rgb), .06), transparent 86%);
  filter: blur(84px);
  opacity: .80;
}

/* ---------------- Grain ---------------- */
.__grain{
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -2;
  opacity: .10;
  mix-blend-mode: overlay;
  background:
    repeating-linear-gradient(
      0deg,
      rgba(255,255,255,.05) 0px,
      rgba(255,255,255,.05) 1px,
      rgba(0,0,0,0) 2px,
      rgba(0,0,0,0) 4px
    );
  filter: blur(.25px);
}

/* ---------------- Particles layer (your current DOM particles) ---------------- */
#clickozParticles{
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  overflow: hidden;
}
.pidle, .pburst{
  position:absolute;
  border-radius:999px;
  background: rgba(var(--accent-rgb), .96);
  box-shadow:
    0 0 14px rgba(var(--accent-rgb), .55),
    0 0 44px rgba(var(--accent-rgb), .22);
  will-change: transform, opacity;
}
.pidle{
  width: 2px;
  height: 2px;
  opacity: .22;
  animation: idleDrift var(--idur) ease-in-out infinite;
}
@keyframes idleDrift{
  0%   { transform: translate3d(0,0,0); opacity: .10; }
  50%  { transform: translate3d(var(--ix), var(--iy), 0); opacity: .20; }
  100% { transform: translate3d(0,0,0); opacity: .10; }
}
.pburst{
  left: var(--sx);
  top:  var(--sy);
  width: var(--sz);
  height: var(--sz);
  opacity: 0;
  transform: translate(-50%, -50%) scale(.65);
  animation: burstFly var(--dur) cubic-bezier(.12,.9,.18,1) forwards;
  animation-delay: var(--delay);
  box-shadow:
    0 0 18px rgba(var(--accent-rgb), .55),
    0 0 70px rgba(var(--accent-rgb), .18);
}
@keyframes burstFly{
  0%   { opacity: 0; transform: translate(-50%,-50%) scale(.55); }
  10%  { opacity: var(--op); }
  100% { opacity: 0; transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.12); }
}

/* ---------------- Canvas particles (future: spaceParticles) ---------------- */
#spaceParticles{
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .55;
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce){
  #clickozParticles, #spaceParticles, .__grain{ display:none !important; }
}

/* ---------------- Container ---------------- */
.container{
  width: min(1120px, calc(100% - 32px));
  margin: 0 auto;
}

/* ---------------- NAV ---------------- */
.nav{
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(11,15,25,.72);
  border-bottom: 1px solid rgba(255,255,255,.08);
  backdrop-filter: blur(10px);
}
.nav-inner{
  min-height: var(--navH);
  display:flex;
  align-items:center;
  gap: 10px;
  padding: 14px 0;
}

/* Logo */
.logo{
  display:flex;
  align-items:center;
  gap:10px;
  text-decoration:none;
  font-weight: 1000;
  letter-spacing: -0.03em;
  font-size: 18px;
  line-height: 1;
}

/* Badge = clean (no background), follows accent */
.logo-badge{
  width: 48px;
  height: 48px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius: 14px;
  background: transparent;
  box-shadow: none;
  color: var(--accent);
}
.logo-mark{ width: 40px; height: 40px; display:block; }
.logo-text{ font-weight: 900; letter-spacing: -0.02em; font-size: 20px; }
.logo-oz{ font-weight: 1000; color: var(--accent); }

.spacer{ flex: 1; }

.nav-links{
  display:flex;
  align-items:center;
  gap: 14px;
  margin-left: 12px;
  font-weight: 900;
  font-size: 14px;
  color: rgba(255,255,255,.78);
}
.nav-links a{
  text-decoration:none;
  padding: 8px 10px;
  border-radius: 10px;
}
.nav-links a:hover{
  background: rgba(var(--accent-rgb), .12);
  color: rgba(255,255,255,.94);
}

.nav-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

/* Accent dropdown */
.dropdown{ position:relative; }
.dot-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(255,255,255,.04);
  border: 1px solid var(--border);
  cursor:pointer;
  transition: background .12s ease, border-color .12s ease, box-shadow .12s ease;
}
.dot-btn:hover{
  background: rgba(255,255,255,.07);
  border-color: var(--border2);
  box-shadow: var(--shadow2);
}
.dot-btn:focus{
  outline:none;
  box-shadow: var(--focus);
  border-color: rgba(var(--accent-rgb), .55);
}
.dot{
  width: 14px;
  height: 14px;
  border-radius: 999px;
  background: var(--accent);
  border: 2px solid rgba(255,255,255,.22);
}

.menu{
  position:absolute;
  top:52px;
  right:0;
  min-width:240px;
  background: #0c1222;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow2);
  padding: 10px;
  display:none;
  z-index:999;
  text-align:left;
}
.menu.active{ display:block; }

.menu-title{
  font-size: 12px;
  letter-spacing: .10em;
  text-transform: uppercase;
  color: rgba(255,255,255,.58);
  padding: 8px 10px 6px;
}
.color-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
  padding:6px 8px 10px;
}
.color-option{
  width: 34px;
  height: 34px;
  border-radius: 999px;
  border: 2px solid rgba(255,255,255,.12);
  cursor:pointer;
  transition: border-color .12s ease, transform .12s ease;
}
.color-option:hover{ border-color: rgba(255,255,255,.28); transform: translateY(-1px); }
.color-option.active{ border-color: rgba(255,255,255,.85); }

/* Google Translate wrapper in nav */
#gtNavWrap{ display:none; align-items:center; }
#gtNavWrap.show{ display:inline-flex; }

/* ---------------- MOBILE NAV (drawer) ---------------- */
.burger{
  display:none;
  width: 44px;
  height: 42px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  align-items:center;
  justify-content:center;
  gap: 5px;
  flex-direction: column;
}
.burger span{
  width: 18px;
  height: 2px;
  background: rgba(242,242,255,.88);
  border-radius: 10px;
}

.m-overlay{
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.55);
  z-index: 80;
}
.m-menu{
  position: fixed;
  top: 0;
  right: 0;
  height: 100%;
  width: min(360px, 88vw);
  background: rgba(11,15,25,.92);
  border-left: 1px solid rgba(255,255,255,.10);
  backdrop-filter: blur(16px);
  z-index: 90;
  transform: translateX(102%);
  transition: transform .22s ease;
  padding: 14px;
  display:flex;
  flex-direction: column;
  gap: 14px;
}
.m-menu.open{ transform: translateX(0); }

.m-head{
  display:flex;
  align-items:center;
  justify-content: space-between;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(255,255,255,.08);
}
.m-title{
  font-weight: 1000;
  letter-spacing: -0.02em;
}
.m-close{
  width: 40px;
  height: 40px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.05);
  color: rgba(242,242,255,.9);
  font-size: 22px;
}

.m-links{
  display:flex;
  flex-direction: column;
  gap: 10px;
}
.m-link{
  padding: 12px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.04);
  text-decoration: none;
  color: rgba(242,242,255,.92);
  font-weight: 900;
}

.m-block{
  padding: 12px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.03);
}
.m-label{
  font-weight: 900;
  margin-bottom: 10px;
  color: rgba(242,242,255,.86);
}
.m-colors{ gap: 10px; }

/* On mobile: hide top links, show burger, move GT to drawer */
@media (max-width: 980px){
  .nav-links{ display:none; }
  .burger{ display:flex; }
  #gtNavWrap{ display:none !important; }
}

/* ---------------- HERO / Sections ---------------- */
.hero{ padding: 34px 0 10px; text-align:center; }
.section{ padding: 28px 0; text-align:center; }

.row{
  display:flex;
  align-items:center;
  gap: 10px;
  flex-wrap: wrap;
  justify-content:center;
}

.badge{
  display:inline-flex;
  gap:8px;
  align-items:center;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(var(--accent-rgb), .10);
  border: 1px solid rgba(var(--accent-rgb), .24);
  color: rgba(255,255,255,.82);
  font-size: 13px;
  font-weight: 900;
  box-shadow: 0 18px 60px rgba(var(--accent-rgb), .10);
}

.hero h1{
  font-size: clamp(34px, 4.2vw, 62px);
  max-width: 1080px;
  letter-spacing: -0.03em;
  line-height: 1.06;
  margin: 12px auto 0;
}
.hero p{
  font-size: 18px;
  line-height: 1.75;
  max-width: 980px;
  color: var(--muted);
  margin: 14px auto 10px;
}

.section-title{
  font-size: clamp(26px, 2.8vw, 40px);
  letter-spacing: -0.02em;
  margin: 0 auto;
  max-width: 980px;
}
.section-sub{
  font-size: 16px;
  color: var(--muted);
  max-width: 980px;
  margin: 10px auto 18px;
}

/* hero-box (your transparent black panels) */
.hero-box{
  background: rgba(0,0,0,.38);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 18px;
  padding: 16px 16px;
  backdrop-filter: blur(10px);
  box-shadow: 0 10px 30px rgba(0,0,0,.35);
}
.box-title{ margin: 0 0 8px; font-size: 18px; font-weight: 1000; letter-spacing:-.02em; }
.box-sub{ margin: 0; opacity: .9; }
.box-foot{ margin-top: 12px; font-size: 14px; opacity: .8; }

/* trust pills */
.trust-strip{
  display:flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content:center;
}
.trust-pill{
  font-size: 14.5px;
  padding: 8px 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.10);
  color: rgba(255,255,255,.86);
}

/* ---------------- Buttons ---------------- */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  height: 44px;
  padding: 0 14px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.04);
  color: rgba(255,255,255,.90);
  text-decoration:none;
  font-weight: 900;
  font-size: 16px;
  cursor:pointer;
  transition: background .12s ease, border-color .12s ease, filter .12s ease;
}
.btn:hover{
  background: rgba(255,255,255,.07);
  border-color: rgba(255,255,255,.18);
}
.btn.primary{
  background: var(--accent);
  border-color: rgba(255,255,255,.12);
  box-shadow: 0 10px 22px rgba(var(--accent-rgb), .18);
}
.btn.primary:hover{ filter: brightness(1.05); }

/* ---------------- Grids + Cards ---------------- */
.small-grid{
  display:grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 14px;
}
.grid{
  display:grid;
  grid-template-columns: 1fr;
  gap: 12px;
  margin-top: 14px;
  align-items: stretch;
}

/* Desktop columns */
@media (min-width: 981px){
  .small-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
}

.small-card, .card{
  padding: 16px;
  border-radius: var(--radius);
  text-decoration:none;

  border: 1px solid rgba(255,255,255,.10);
  background: rgba(15,21,38,.58);
  box-shadow: 0 16px 50px rgba(0,0,0,.28);
  transition: border-color .12s ease, background .12s ease, box-shadow .12s ease;
  text-align:left;
}
.small-card:hover, .card:hover{
  background: rgba(17,26,48,.80);
  border-color: rgba(var(--accent-rgb), .55);
  box-shadow:
    0 0 0 1px rgba(var(--accent-rgb), .18),
    0 22px 70px rgba(0,0,0,.42),
    0 18px 44px rgba(var(--accent-rgb), .12);
}

.small-card h3{ margin: 0 0 8px; font-size: 16px; font-weight: 1000; }
.small-card p{
  margin: 0;
  font-size: 14.5px;
  line-height: 1.65;
  color: rgba(255,255,255,.72);
}

/* ---- Card content alignment (emoji + title SAME ROW) ---- */
.card{
  display:flex;
  flex-direction: column;
  gap: 10px;
  height: 100%;
}

/* Header row */
.card-head{
  display:flex;
  align-items:center;
  gap: 12px;
  min-height: 46px;
}

/* Thumb (emoji) */
.thumb{
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex: 0 0 auto;

  background: rgba(var(--accent-rgb), .10);
  border: 1px solid rgba(var(--accent-rgb), .22);
  font-size: 20px;
  box-shadow: 0 10px 22px rgba(var(--accent-rgb), .10);
}

/* Title aligned with thumb */
.card-head h3,
.card h3{
  margin: 0;
  font-size: 16px;
  font-weight: 1000;
  letter-spacing: -0.01em;
  line-height: 1.15;
}

/* Paragraphs */
.card p{
  margin: 0;
  font-size: 14.5px;
  line-height: 1.65;
  color: rgba(255,255,255,.72);
}

.example-line{
  margin-top: 2px;
  font-size: 13.5px;
  line-height: 1.55;
  color: rgba(255,255,255,.62);
}

/* CTA pinned bottom */
.tool-cta{
  margin-top: auto;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width: 100%;
  height: 40px;
  border-radius: 12px;
  font-weight: 1000;
  font-size: 13px;
  letter-spacing: .01em;
  background: var(--accent);
  color: rgba(255,255,255,.96);
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 10px 22px rgba(var(--accent-rgb), .18);
}
.tool-cta:hover{ filter: brightness(1.05); }

/* ---------------- Recommended now ---------------- */
.rec-grid{
  display:grid;
  gap: 12px;
  margin-top: 14px;
  grid-template-columns: 1fr;
  align-items: stretch;
  text-align:left;
}
@media (min-width: 981px){
  .rec-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
}

.rec-card{
  display:flex;
  flex-direction: column;
  height: 100%;
}
.rec-head{
  display:flex;
  align-items:center;
  gap: 12px;
  min-height: 46px;
}
.rec-icon{
  width: 46px;
  height: 46px;
  border-radius: 12px;
  display:flex;
  align-items:center;
  justify-content:center;
  background: rgba(var(--accent-rgb), .10);
  border: 1px solid rgba(var(--accent-rgb), .22);
  font-size: 20px;
  box-shadow: 0 10px 22px rgba(var(--accent-rgb), .10);
}
.rec-card h3{ margin: 0; font-size: 18px; font-weight: 1000; line-height: 1.15; }
.rec-card p{ margin: 10px 0 0; color: var(--muted); }
.rec-card .tool-cta{ margin-top: auto; }

/* ---------------- Search + chips ---------------- */
input.search{
  background: rgba(15,21,38,.70);
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 12px;
  outline: none;
  width: min(920px, 100%);
  margin: 0 auto;
  display:block;
  text-align:left;
  padding: 12px 12px;
}
input.search::placeholder{ color: rgba(255,255,255,.55); }
input.search:focus{
  border-color: rgba(var(--accent-rgb), .55);
  box-shadow: var(--focus);
}

.chips{
  display:flex;
  flex-wrap:wrap;
  gap: 10px;
  margin: 14px 0 14px;
  justify-content:center;
}
.chip{
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 1000;
  cursor:pointer;
  user-select:none;
  background: rgba(255,255,255,.02);
  border: 1px solid var(--border);
  color: rgba(255,255,255,.78);
  transition: background .12s ease, border-color .12s ease;
}
.chip:hover{ background: rgba(255,255,255,.05); }
.chip.active{
  color: var(--text);
  border-color: rgba(var(--accent-rgb), .55);
  background: rgba(var(--accent-rgb), .12);
}

/* ---------------- Footer ---------------- */
.footer{
  margin-top: 24px;
  padding: 22px 0 14px;
  border-top: 1px solid rgba(255,255,255,.08);
  background: rgba(0,0,0,.38);
  backdrop-filter: blur(10px);
  text-align:center;
}
.footer-grid{
  display:grid;
  grid-template-columns: 1fr;
  gap: 16px;
  text-align:center;
}
@media (min-width: 981px){
  .footer-grid{ grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
.footer h4{
  margin: 0 0 10px;
  font-size: 14px;
  color: rgba(255,255,255,.80);
  font-weight: 900;
}
.footer-links{
  display:flex;
  flex-direction:column;
  gap: 8px;
  align-items:center;
  justify-content:center;
}
.footer a{
  text-decoration:none;
  color: rgba(255,255,255,.70);
  font-weight: 800;
  font-size: 14px;
}
.footer a:hover{ color: rgba(255,255,255,.92); }
.sep{ border:none; border-top: 1px solid rgba(255,255,255,.08); }

/* ---------------- Cookie banner ---------------- */
.cookie{
  position: fixed;
  left: 16px;
  right: 16px;
  bottom: 16px;
  z-index: 2000;
  display: none;
  pointer-events: none;
}
.cookie.show{ display:block; }

.cookie-card{
  pointer-events: auto;
  width: min(920px, 100%);
  margin: 0 auto;
  background: rgba(15, 21, 38, .92);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 18px;
  box-shadow: 0 20px 60px rgba(0,0,0,.55);
  backdrop-filter: blur(12px);

  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;

  padding: 14px 14px;
  transform: translateY(10px);
  opacity: 0;
  transition: transform .18s ease, opacity .18s ease;
  position: relative;
}
.cookie.show .cookie-card{ transform: translateY(0); opacity: 1; }

@media (min-width: 721px){
  .cookie-card{ grid-template-columns: 1fr auto; }
}

.cookie-x{
  position: absolute;
  top: 10px;
  right: 10px;
  width: 34px;
  height: 34px;
