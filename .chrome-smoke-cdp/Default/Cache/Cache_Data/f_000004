/* Clickoz home leadership pass.
   Scoped after the existing premium/CMS layers to avoid rewriting shared styles. */

.home-workdesk{
  --cz-home-line:rgba(var(--accent-rgb), .20);
  --cz-home-line-strong:rgba(var(--accent-rgb), .42);
  --cz-home-panel:rgba(5, 12, 24, .78);
  --cz-home-panel-strong:rgba(9, 18, 34, .92);
  --cz-home-copy:rgba(248, 252, 255, .72);
}

.home-workdesk .cz-workdesk-hero.hero-simple-v2{
  width:min(1280px, calc(100% - 44px));
  min-height:min(760px, calc(100vh - var(--navH, 72px) - 28px));
  display:grid;
  grid-template-columns:minmax(0, 1.05fr) minmax(390px, .82fr);
  gap:clamp(16px, 2vw, 24px);
  align-items:stretch;
  margin:0 auto;
  padding:clamp(28px, 4vw, 58px) 0 clamp(18px, 3vw, 42px);
}

.home-workdesk .cz-workdesk-hero.hero-simple-v2::before{
  height:760px;
  background:
    linear-gradient(115deg, rgba(var(--accent-rgb), .18), transparent 42%),
    linear-gradient(rgba(var(--accent-rgb), .12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--accent-rgb), .09) 1px, transparent 1px),
    radial-gradient(900px 520px at 22% 6%, rgba(var(--accent-rgb), .28), transparent 68%),
    radial-gradient(720px 420px at 84% 10%, rgba(16, 185, 129, .12), transparent 72%),
    radial-gradient(680px 420px at 50% 88%, rgba(236, 72, 153, .10), transparent 76%);
  background-size:auto, 56px 56px, 56px 56px, auto, auto, auto;
  opacity:.82;
}

.home-workdesk .workdesk-copy,
.home-workdesk .platform-dashboard-panel{
  min-width:0;
  border:1px solid var(--cz-home-line);
  border-radius:26px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.09), rgba(255,255,255,.025)),
    var(--cz-home-panel);
  box-shadow:
    0 34px 105px rgba(0,0,0,.46),
    inset 0 1px 0 rgba(255,255,255,.10),
    0 0 0 1px rgba(var(--accent-rgb), .045);
  backdrop-filter:blur(20px) saturate(1.12);
  -webkit-backdrop-filter:blur(20px) saturate(1.12);
}

.home-workdesk .workdesk-copy{
  min-height:620px;
  justify-content:center;
  padding:clamp(28px, 4.5vw, 58px);
}

.home-workdesk .cz-workdesk-hero.hero-simple-v2 .dash-kicker{
  width:max-content;
  max-width:100%;
  margin-bottom:clamp(18px, 3vw, 34px);
  border-color:rgba(var(--accent-rgb), .36);
  background:
    linear-gradient(90deg, rgba(var(--accent-rgb), .18), rgba(16, 185, 129, .10)),
    rgba(255,255,255,.035);
  color:rgba(248, 252, 255, .88);
}

.home-workdesk .workdesk-copy h1{
  max-width:900px;
  font-size:clamp(48px, 6.5vw, 92px);
  line-height:.94;
  letter-spacing:0 !important;
  text-wrap:balance;
}

.home-workdesk .cz-workdesk-hero.hero-simple-v2 .hero-workdesk-sub{
  max-width:760px;
  margin-top:clamp(18px, 2.2vw, 24px);
  color:var(--cz-home-copy);
  font-size:clamp(17px, 1.45vw, 21px);
  line-height:1.62;
}

.home-workdesk .hero-direct-actions{
  gap:10px;
  margin-top:clamp(22px, 3vw, 32px);
}

.home-workdesk .hero-direct-actions .btn,
.home-workdesk .hero-fix-input-row .btn{
  min-height:48px;
  border-radius:12px;
  padding-inline:16px;
}

.home-workdesk .hero-fix-console{
  max-width:780px;
  margin-top:clamp(22px, 3vw, 30px);
  border-radius:18px;
  border-color:rgba(var(--accent-rgb), .28);
  background:
    linear-gradient(135deg, rgba(var(--accent-rgb), .13), rgba(16, 185, 129, .045)),
    rgba(0,0,0,.24);
}

.home-workdesk .hero-console-head{
  display:flex;
  justify-content:space-between;
  gap:12px;
  margin-bottom:12px;
  color:rgba(248,252,255,.64);
  font-size:12px;
  font-weight:850;
  text-transform:uppercase;
}

.home-workdesk .hero-console-head strong{
  color:#fff;
  text-align:right;
}

.home-workdesk .hero-fix-console label{
  font-size:clamp(16px, 1.5vw, 19px);
  font-weight:850;
}

.home-workdesk .hero-job-chips button,
.home-workdesk .live-demo-tabs button{
  transition:transform .16s ease, border-color .16s ease, background .16s ease, color .16s ease;
}

.home-workdesk .hero-job-chips button:hover,
.home-workdesk .live-demo-tabs button:hover{
  transform:translateY(-1px);
}

.home-workdesk .cz-workdesk-hero.hero-simple-v2 .hero-flow-row{
  margin-top:14px;
  border-color:rgba(var(--accent-rgb), .16);
  background:rgba(255,255,255,.035);
}

.home-workdesk .cz-workdesk-hero.hero-simple-v2 .hero-assurance-row{
  max-width:780px;
  margin-top:clamp(18px, 2.8vw, 28px);
}

.home-workdesk .platform-dashboard-panel{
  position:relative;
  display:flex;
  flex-direction:column;
  gap:14px;
  min-height:620px;
  padding:clamp(16px, 2vw, 22px);
  overflow:hidden;
}

.home-workdesk .platform-dashboard-panel::before{
  content:"";
  position:absolute;
  inset:66px 16px 16px;
  border:1px solid rgba(var(--accent-rgb), .10);
  border-radius:22px;
  background:
    linear-gradient(rgba(var(--accent-rgb), .09) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--accent-rgb), .07) 1px, transparent 1px);
  background-size:32px 32px;
  mask-image:linear-gradient(to bottom, transparent 0%, #000 16%, #000 86%, transparent 100%);
  opacity:.62;
  pointer-events:none;
}

.home-workdesk .platform-dashboard-panel > *{
  position:relative;
  z-index:1;
}

.home-workdesk .live-demo-top{
  min-height:44px;
  padding-bottom:4px;
}

.home-workdesk .platform-pulse{
  width:12px;
  height:12px;
  border-radius:50%;
  background:rgb(var(--accent-rgb));
  box-shadow:0 0 0 6px rgba(var(--accent-rgb), .10), 0 0 34px rgba(var(--accent-rgb), .52);
}

.home-workdesk .live-demo-top small{
  padding:7px 10px;
  border:1px solid rgba(var(--accent-rgb), .18);
  border-radius:999px;
  background:rgba(var(--accent-rgb), .08);
}

.home-workdesk .platform-signal-map{
  display:grid;
  grid-template-columns:repeat(4, minmax(0, 1fr));
  gap:8px;
}

.home-workdesk .platform-signal-map span{
  min-height:48px;
  display:grid;
  place-items:center;
  border:1px solid rgba(var(--accent-rgb), .16);
  border-radius:14px;
  color:rgba(248,252,255,.78);
  background:
    linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.025)),
    rgba(0,0,0,.16);
  font:850 12px/1 var(--font-head, var(--font-display, system-ui));
  text-transform:uppercase;
}

.home-workdesk .platform-signal-map span:nth-child(2){
  border-color:rgba(236, 72, 153, .24);
}

.home-workdesk .platform-signal-map span:nth-child(3){
  border-color:rgba(16, 185, 129, .24);
}

.home-workdesk .platform-signal-map span:nth-child(4){
  border-color:rgba(245, 158, 11, .24);
}

.home-workdesk .live-demo-tabs{
  grid-template-columns:repeat(4, minmax(0, 1fr));
}

.home-workdesk .live-demo-tabs button{
  min-width:0;
  border-radius:12px;
  font-size:12px;
}

.home-workdesk .live-demo-input{
  gap:8px;
}

.home-workdesk .live-demo-input span{
  color:rgba(248,252,255,.66);
  font-size:12px;
  font-weight:850;
  text-transform:uppercase;
}

.home-workdesk .live-demo-input textarea{
  min-height:118px;
  max-height:190px;
  border-radius:16px;
  font-size:14px;
}

.home-workdesk .live-demo-output{
  flex:1;
  min-height:196px;
  border-radius:18px;
  background:
    linear-gradient(145deg, rgba(255,255,255,.055), rgba(255,255,255,.018)),
    rgba(0,0,0,.24);
}

.home-workdesk .demo-result{
  min-height:100%;
  align-content:center;
}

.home-workdesk .demo-result strong{
  font-size:clamp(20px, 2vw, 25px);
}

.home-workdesk .demo-result p{
  color:rgba(248,252,255,.68);
}

.home-workdesk .demo-stat-grid{
  margin-top:2px;
}

.home-workdesk .demo-stat-grid span{
  border-radius:13px;
}

.home-workdesk .platform-route-stack{
  display:grid;
  grid-template-columns:repeat(2, minmax(0, 1fr));
  gap:9px;
}

.home-workdesk .platform-route-stack a{
  min-height:82px;
  display:grid;
  grid-template-columns:auto minmax(0, 1fr);
  column-gap:10px;
  row-gap:4px;
  align-items:center;
  border:1px solid rgba(var(--accent-rgb), .14);
  border-radius:16px;
  padding:12px;
  color:inherit;
  text-decoration:none;
  background:rgba(255,255,255,.035);
  transition:transform .16s ease, border-color .16s ease, background .16s ease, box-shadow .16s ease;
}

.home-workdesk .platform-route-stack span{
  grid-row:span 2;
  width:34px;
  height:34px;
  display:grid;
  place-items:center;
  border-radius:11px;
  color:rgb(var(--accent-rgb));
  border:1px solid rgba(var(--accent-rgb), .20);
  background:rgba(var(--accent-rgb), .09);
  font-size:12px;
  font-weight:900;
}

.home-workdesk .platform-route-stack strong{
  color:#fff;
  font-size:14px;
  line-height:1.05;
}

.home-workdesk .platform-route-stack em{
  color:rgba(248,252,255,.56);
  font-size:12px;
  font-style:normal;
  line-height:1.2;
}

.home-workdesk .platform-route-stack a.active{
  border-color:var(--cz-home-line-strong);
  background:
    linear-gradient(135deg, rgba(var(--accent-rgb), .14), rgba(255,255,255,.04)),
    rgba(255,255,255,.035);
  box-shadow:0 18px 48px rgba(var(--accent-rgb), .12);
}

.home-workdesk .platform-route-stack a:hover{
  transform:translateY(-2px);
  border-color:var(--cz-home-line-strong);
}

.home-workdesk .live-demo-actions{
  margin-top:auto;
  align-items:center;
}

.home-workdesk .live-demo-actions a,
.home-workdesk .demo-sample-chip{
  min-height:42px;
  border-radius:12px;
}

.home-workdesk .friendly-tools-section,
.home-workdesk .authority-picker,
.home-workdesk .authority-split,
.home-workdesk > .route-final-strip,
.home-workdesk > .request-mega-cta{
  border-radius:26px;
}

.home-workdesk .friendly-section-intro h2,
.home-workdesk .authority-head h2,
.home-workdesk .authority-panel h2{
  letter-spacing:0 !important;
  text-wrap:balance;
}

.home-workdesk .picks-grid .pick-card,
.home-workdesk .authority-card{
  border-color:rgba(var(--accent-rgb), .17);
  background:
    linear-gradient(145deg, rgba(255,255,255,.075), rgba(255,255,255,.023)),
    rgba(6, 14, 28, .76);
  box-shadow:
    0 22px 70px rgba(0,0,0,.34),
    inset 0 1px 0 rgba(255,255,255,.08);
}

.home-workdesk .picks-grid .pick-card{
  min-height:210px;
}

.home-workdesk .pick-head{
  align-items:flex-start;
}

.home-workdesk .pick-icon,
.home-workdesk .authority-card-head span{
  box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 14px 34px rgba(var(--accent-rgb), .08);
}

.home-workdesk .pick-title,
.home-workdesk .authority-card h3{
  letter-spacing:0 !important;
  text-wrap:balance;
}

.home-workdesk .pick-desc,
.home-workdesk .authority-card p{
  color:rgba(248,252,255,.68);
}

@media (hover:hover) and (pointer:fine){
  .home-workdesk .picks-grid .pick-card,
  .home-workdesk .authority-card{
    transition:transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
  }

  .home-workdesk .picks-grid .pick-card:hover,
  .home-workdesk .authority-card:hover{
    transform:translateY(-4px);
    border-color:rgba(var(--accent-rgb), .42);
    box-shadow:
      0 30px 90px rgba(0,0,0,.42),
      0 0 0 1px rgba(var(--accent-rgb), .08),
      0 0 52px rgba(var(--accent-rgb), .08);
  }
}

/* v19 cascade lock: keep tightened hero spacing and LED markers after older layers. */
body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-workdesk-sub{
  margin-top:clamp(12px, 1.6vw, 20px) !important;
  line-height:1.48 !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .dash-actions.hero-direct-actions{
  margin-top:clamp(14px, 1.8vw, 20px) !important;
  margin-bottom:0 !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-fix-console{
  margin-top:clamp(12px, 1.5vw, 16px) !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-router-question{
  margin-bottom:5px !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-input-label{
  margin-bottom:14px !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a::before{
  width:6px !important;
  height:6px !important;
  border:1px solid rgba(255,255,255,.46) !important;
  background:
    radial-gradient(circle at 34% 28%, rgba(255,255,255,.96) 0 16%, rgb(var(--accent-rgb)) 42%, rgba(var(--accent-rgb), .62) 100%) !important;
  box-shadow:
    0 0 0 3px rgba(var(--accent-rgb), .12),
    0 0 12px rgba(var(--accent-rgb), .76),
    0 0 28px rgba(var(--accent-rgb), .42) !important;
  animation:czHeroPromiseLedPulse 1320ms ease-in-out infinite !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a:nth-child(2)::before{
  animation-duration:1760ms !important;
  animation-delay:-420ms !important;
}

body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a:nth-child(3)::before{
  animation-duration:2140ms !important;
  animation-delay:-880ms !important;
}

/* v21: make the router question one pixel quieter without changing hero structure. */
html body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-fix-console .hero-router-question{
  font-size:clamp(12px, calc(1.08vw - 1px), 15px) !important;
}

@media (max-width:760px){
  body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-workdesk-sub{
    margin-top:12px !important;
    line-height:1.45 !important;
  }

  body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .dash-actions.hero-direct-actions{
    margin-top:12px !important;
    margin-bottom:0 !important;
  }

  body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-fix-console{
    margin-top:10px !important;
  }

  body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-input-label{
    margin-bottom:12px !important;
  }
}

/* v22: home pick-color buttons use the same crisp CTA text as the CMS. */
body.bigtext main.home-workdesk :is(
  .btn.btn-accent,
  .btn-accent,
  .pick-cta,
  .rec-refresh
){
  color:#06111f !important;
  -webkit-text-fill-color:#06111f !important;
  -webkit-text-stroke:0 transparent !important;
  paint-order:normal !important;
  font-weight:950 !important;
  font-size:max(15px, 1em) !important;
  line-height:1.12 !important;
  letter-spacing:.005em !important;
  text-shadow:
    0 1px 0 rgba(255,255,255,.72),
    0 0 10px rgba(255,255,255,.24) !important;
  text-rendering:geometricPrecision !important;
}

body.bigtext main.home-workdesk :is(
  .btn.btn-accent,
  .btn-accent,
  .pick-cta,
  .rec-refresh
) *{
  color:inherit !important;
  -webkit-text-fill-color:inherit !important;
  -webkit-text-stroke:inherit !important;
  text-shadow:inherit !important;
}

@media (hover:hover) and (pointer:fine){
  body.bigtext main.home-workdesk :is(
    .btn.btn-accent,
    .btn-accent,
    .pick-cta,
    .rec-refresh
  ):hover,
  body.bigtext main.home-workdesk :is(
    .btn.btn-accent,
    .btn-accent,
    .pick-cta,
    .rec-refresh
  ):focus-visible{
    color:#020812 !important;
    -webkit-text-fill-color:#020812 !important;
    -webkit-text-stroke:0 transparent !important;
    text-shadow:
      0 1px 0 rgba(255,255,255,.88),
      0 0 12px rgba(255,255,255,.32) !important;
    filter:saturate(1.08) brightness(1.04) contrast(1.04) !important;
  }
}

/* v20: stronger palette LEDs for the hero promise rail. */
html body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a::before{
  width:8px !important;
  height:8px !important;
  border:1px solid rgba(255,255,255,.70) !important;
  background:
    radial-gradient(circle at 32% 24%, rgba(255,255,255,1) 0 15%, color-mix(in srgb, rgb(var(--accent-rgb)) 58%, #ffffff 42%) 31%, rgb(var(--accent-rgb)) 58%, color-mix(in srgb, rgb(var(--accent-rgb)) 72%, #000 28%) 100%) !important;
  box-shadow:
    0 0 0 3px rgba(var(--accent-rgb), .18),
    0 0 12px rgba(var(--accent-rgb), .98),
    0 0 28px rgba(var(--accent-rgb), .72),
    0 0 58px rgba(var(--accent-rgb), .42),
    0 0 86px rgba(var(--accent-rgb), .20) !important;
  filter:brightness(1.24) saturate(1.36) !important;
  animation:czHeroPromiseLedPulseStrong 1320ms ease-in-out infinite !important;
}

html body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a:nth-child(2)::before{
  animation-duration:1760ms !important;
  animation-delay:-420ms !important;
}

html body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a:nth-child(3)::before{
  animation-duration:2140ms !important;
  animation-delay:-880ms !important;
}

@keyframes czHeroPromiseLedPulseStrong{
  0%, 100%{
    opacity:.70;
    filter:brightness(1.02) saturate(1.18);
    box-shadow:
      0 0 0 3px rgba(var(--accent-rgb), .12),
      0 0 10px rgba(var(--accent-rgb), .70),
      0 0 26px rgba(var(--accent-rgb), .46),
      0 0 48px rgba(var(--accent-rgb), .22);
  }
  34%{
    opacity:1;
    filter:brightness(1.74) saturate(1.62);
    box-shadow:
      0 0 0 5px rgba(var(--accent-rgb), .24),
      0 0 18px rgba(var(--accent-rgb), 1),
      0 0 44px rgba(var(--accent-rgb), .88),
      0 0 82px rgba(var(--accent-rgb), .54),
      0 0 124px rgba(var(--accent-rgb), .25);
  }
  62%{
    opacity:.86;
    filter:brightness(1.28) saturate(1.36);
    box-shadow:
      0 0 0 4px rgba(var(--accent-rgb), .17),
      0 0 14px rgba(var(--accent-rgb), .88),
      0 0 34px rgba(var(--accent-rgb), .62),
      0 0 66px rgba(var(--accent-rgb), .34);
  }
}

@media (prefers-reduced-motion:reduce){
  html body.bigtext main.home-workdesk > header.cz-workdesk-hero.hero-simple-v2 .hero-assurance-row a::before{
    animation:none !important;
    opacity:1 !important;
    filter:brightness(1.24) saturate(1.34) !important;
  }
}

